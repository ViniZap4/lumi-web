{
  "name": "web-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "bench": "vitest bench --run",
    "bench:gate": "node scripts/perf/bench-gate.mjs",
    "bench:baseline": "node scripts/perf/bench-gate.mjs --update",
    "perf:size": "vite build --manifest && node scripts/perf/size-gate.mjs",
    "perf:size:check": "node scripts/perf/size-gate.mjs",
    "test:props": "FC_RUNS=20000 vitest run property",
    "e2e": "playwright test --project smoke",
    "e2e:update": "playwright test --project smoke --update-snapshots",
    "e2e:full": "E2E_MATRIX=full playwright test",
    "e2e:linux": "docker run --rm -v \"$PWD\":/w -v lumi-e2e-node-modules:/w/node_modules -w /w mcr.microsoft.com/playwright:v1.55.1-noble sh -c 'npm ci --no-audit && npm run build && npx playwright test --project smoke --update-snapshots'"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "22.15.3",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "4.3.0",
    "jsdom": "^25.0.1",
    "playwright-core": "1.55.1",
    "svelte": "^5.45.2",
    "svelte-check": "4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@types/dompurify": "^3.0.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.5",
    "marked": "^18.0.3",
    "mermaid": "12.3.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  }
}
